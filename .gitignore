# OS / editor cruft
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.swp
*.log

# scripts/services.ps1 runtime artifacts -- logs, PID bookkeeping, and the per-run .ps1 files
# it generates to avoid a Start-Process argument-quoting bug (see the script's own comments).
# None of this is authored; it's regenerated by running the script.
scripts/logs/
scripts/.run-state.json

# Environment / secrets
# docker/.env is how Compose picks up OPENAI_API_KEY -- it must never be committed.
.env
.env.*
!.env.example
